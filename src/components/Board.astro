---
export interface Props {
  board: string;
  sort?: "votes-desc" | "votes-asc" | "alpha-asc" | "alpha-desc" | "date-asc" | "date-desc";
}

const { board, sort = "votes-desc" } = Astro.props;
const instanceId = `board-${Math.random().toString(36).slice(2, 10)}`;
---

<div
  class="board-container card-base p-6 mb-4 rounded-3xl bg-[var(--card-bg)] transition-all"
  data-board={board}
  data-default-sort={sort}
  data-board-instance={instanceId}
>
  <h2 class="board-title text-2xl font-bold mb-4 text-[var(--btn-content)]">加载中...</h2>
  
  <div class="board-controls flex items-center gap-2 mb-4 text-sm text-black/50 dark:text-white/50">
    <span>排序：</span>
    <select class="sort-select bg-[var(--btn-regular-bg)] border border-black/10 dark:border-white/10 rounded-lg px-2 py-1 text-[var(--btn-content)]">
      <option value="votes-desc">票数 ↓</option>
      <option value="votes-asc">票数 ↑</option>
      <option value="alpha-asc">名称 A-Z</option>
      <option value="alpha-desc">名称 Z-A</option>
      <option value="date-desc">最新在前</option>
      <option value="date-asc">最早在前</option>
    </select>
  </div>

  <ul class="board-list divide-y divide-black/5 dark:divide-white/5 mb-6"></ul>
</div>

<style>
  .board-list :global(li) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
  }
  .board-list :global(.item-avatar) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .board-list :global(.dot) {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .board-list :global(.item-info) {
    flex: 1;
  }
</style>

<script>
  const BASE_URL = import.meta.env.BASE_URL ?? '/';

  function resolvePublicUrl(path: string) {
    if (!path) return '';
    if (/^(?:[a-z]+:)?\/\//i.test(path) || path.startsWith('data:')) return path;

    const normalizedBase = BASE_URL.endsWith('/') ? BASE_URL : `${BASE_URL}/`;
    const cleanPath = path.startsWith('/') ? path.slice(1) : path;
    return new URL(cleanPath, window.location.origin + normalizedBase).toString();
  }

  function initBoard(boardContainer: HTMLElement) {
    if (boardContainer.dataset.boardInitialized === 'true') return;
    boardContainer.dataset.boardInitialized = 'true';

    const board = boardContainer.getAttribute('data-board') || 'default';
    const defaultSort = boardContainer.getAttribute('data-default-sort') || 'votes-desc';
    const boardName = board.replace(/\.json$/i, '');
    const dataUrl = resolvePublicUrl(`data/Board/${boardName}.json`);

    let currentSort = defaultSort;
    const sortSelect = boardContainer.querySelector('.sort-select') as HTMLSelectElement | null;
    if (sortSelect) sortSelect.value = defaultSort;

    function escapeHtml(text: string) {
      return text.replace(/[&<>\"]/g, (ch) => {
        const map: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' };
        return map[ch];
      });
    }

    function sortItems(items: any[], sort: string) {
      const list = [...items];
      switch (sort) {
        case 'votes-asc':
          return list.sort((a, b) => a.votes - b.votes);
        case 'alpha-asc':
          return list.sort((a, b) => a.title.localeCompare(b.title));
        case 'alpha-desc':
          return list.sort((a, b) => b.title.localeCompare(a.title));
        case 'date-asc':
          return list.sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime());
        case 'date-desc':
          return list.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
        case 'votes-desc':
        default:
          return list.sort((a, b) => b.votes - a.votes);
      }
    }

    async function renderList() {
      try {
        const res = await fetch(dataUrl);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        const config = data?.config || data || {};
        const items = Array.isArray(data?.items) ? data.items : [];
        const sortedItems = sortItems(items, currentSort);

        const titleEl = boardContainer.querySelector('.board-title');
        if (titleEl) titleEl.textContent = config.title || boardName;

        const list = boardContainer.querySelector('.board-list');
        if (!list) return;
        list.innerHTML = '';

        if (!sortedItems.length) {
          list.innerHTML = '<li class="text-black/40 dark:text-white/40 text-sm justify-center py-4">暂无数据</li>';
          return;
        }

        sortedItems.forEach((item: any) => {
          const li = document.createElement('li');

          let avatarHtml = '';
          if (config.showAvatar && item.avatar) {
            const avatarPath = item.avatar.startsWith('/') ? item.avatar : `Board/${boardName}/${item.avatar}`;
            avatarHtml = `<img src="${resolvePublicUrl(avatarPath)}" class="item-avatar" alt="${escapeHtml(item.title)}" onerror="this.style.display='none'"/>`;
          } else {
            const dotColor = item.dotColor || config.defaultDotColor || '#d3d3d3';
            avatarHtml = `<span class="dot" style="background-color: ${dotColor};"></span>`;
          }

          li.innerHTML = `
            ${avatarHtml}
            <div class="item-info">
              <span class="font-medium text-[var(--btn-content)]">${escapeHtml(item.title)}</span>
              <span class="text-xs opacity-50 ml-2">(${item.votes ?? 0} 获赞)</span>
            </div>
          `;
          list.appendChild(li);
        });
      } catch (e) {
        console.error('Fetch board error:', e);
        const list = boardContainer.querySelector('.board-list');
        if (list) {
          list.innerHTML = '<li class="text-black/40 dark:text-white/40 text-sm justify-center py-4">加载失败</li>';
        }
      }
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        currentSort = sortSelect.value;
        renderList();
      });
    }

    renderList();
  }

  function initAllBoards() {
    document.querySelectorAll<HTMLElement>('.board-container').forEach((container) => initBoard(container));
  }

  document.addEventListener('astro:page-load', initAllBoards);
  document.addEventListener('DOMContentLoaded', initAllBoards);
  initAllBoards();
</script>
