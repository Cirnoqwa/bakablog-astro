---
// ⚡️ 核心：让组件接受一个名为 data 的参数
interface Props {
  data: {
    nodes: Array<{ id: string; name: string; icon: string }>;
    links: Array<{ source: string; target: string; label: string }>;
  };
}

const { data: graphData } = Astro.props;
---

<div class="mod-graph-container">
  <div class="echarts-main"></div>
</div>

<script>
  import * as echarts from 'echarts';

  // 找齐页面上所有的图表容器（支持同页多图）
  const containers = document.querySelectorAll('.echarts-main');
  
  containers.forEach(container => {
    // ⚡️ 绝招：通过 dataset 把 Astro 后端拿到的动态数据，安全地塞给前端 script
    const graphData = JSON.parse(container.getAttribute('data-graph') || '{}');
    if (!graphData.nodes) return;

    const myChart = echarts.init(container as HTMLElement, 'dark');

    const option = {
      backgroundColor: '#111',
      tooltip: { trigger: 'item' },
      series: [
        {
          type: 'graph',
          layout: 'force',
          roam: true,
          draggable: true,
          focusNodeAdjacency: true,
          data: graphData.nodes.map((node: any) => ({
            id: node.id,
            name: node.name,
            symbol: `image://${node.icon}`,
            symbolSize: 40,
            label: { show: true, position: 'bottom', color: '#fff' }
          })),
          edges: graphData.links.map((link: any) => ({
            source: link.source,
            target: link.target,
            label: { show: true, formatter: link.label, fontSize: 10 },
            lineStyle: { color: 'rgba(255,255,255,0.3)', width: 2, curveness: 0.1 }
          })),
          force: { repulsion: 400, edgeLength: 180, gravity: 0.05 }
        }
      ]
    };

    myChart.setOption(option);
    window.addEventListener('resize', () => myChart.resize());
  });
</script>

<style>
  .mod-graph-container { width: 100vw; height: 100vh; overflow: hidden; }
  .echarts-main { width: 100%; height: 100%; }
</style>